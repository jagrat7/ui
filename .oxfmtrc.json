{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "public/r/**",
    "next-env.d.ts",
    "pnpm-lock.yaml"
  ]
}
